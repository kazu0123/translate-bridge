{
  "version": "1",

  // API の待ち受けアドレス
  "listen_address": "127.0.0.1:5050",

  // OpenAI Chat Completions 互換 API の接続先
  "upstream_base_url": "http://127.0.0.1:1234/v1",

  // バックエンドの API キー
  "upstream_api_key": "",

  // 翻訳モデル
  "translation_model": {
    "id": "translategemma-27b-it",
    "max_tokens": 512,

    "type": "translategemma"
    // モデルが想定する、言語情報の入力形式を指定
    // - "translategemma": Google 公式モデルが求める、構造化された入力を想定（ https://huggingface.co/google/translategemma-27b-it ）
    // - "translategemma-vllm": vLLM 互換翻訳モデルが求める、インライン入力形式を想定（ https://huggingface.co/Infomaniak-AI/vllm-translategemma-27b-it ）
    // - "translategemma-nullpolab-any2any": ぬるぽらぼ 様によるLM Studio様jinjaテンプレートから、any_to_any.txtを想定（ https://note.com/nullpolab/n/n4e35910902d3 ）
    // - "generic" or other: 汎用モデルのための、インライン入力を想定
  },

  // 言語判定モデル
  "detection_model": {
    "id": "qwen/qwen3-4b",
    "max_tokens": 32
  }
}
